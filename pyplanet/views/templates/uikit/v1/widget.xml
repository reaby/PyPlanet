{% extends 'core.views/uikit/v1/generics/bootstrap_widget.xml' %}

{% block main %}
<frame pos="{{ widget_x }} {{ widget_y }}" z-index="{{ z_index }}" data-sizex="{{size_x}}" data-sizey="{{size_y}}" id="Window" class="{% if distraction_hide %}distraction-hide{% endif %}">
  {% block title %}
      {% if title %}
          {% if open_action %}
          <label pos="2 -2.25" z-index="3" size="35 4" text="$t$i{{ title }}" valign="center2" textfont="GameFontExtraBold" textprefix="$i$t" textsize="1" halign="left" action="{{ id }}__open_widget" focusareacolor1="0000" focusareacolor2="0000"/>
          {% else %}
           <label pos="2 -2.25" z-index="3" size="35 4" text="$t$i{{ title }}" valign="center2" textfont="GameFontExtraBold" textprefix="$i$t" textsize="1" halign="left" focusareacolor1="0000" focusareacolor2="0000"/>
          {% endif %}
				<quad z-index="2" pos="20 -2"  size="40 4.1" image="file://Media/Painter/Stencils/15-Stripes/_Stripe0Grad/Brush.tga" modulatecolor="108AEEFF" halign="center" valign="center"/>
      {% endif %}
  {% endblock %}

  <frame pos="0 {% if title %}-4.5{% else %}0{% endif %}">
    {% block content %}{% endblock %}
  </frame>

</frame>
{% endblock %}

{% block maniascript %}
  <script><!-- {% include 'core.views/uikit/v1/scripts/toggle_ui.Script.txt' %} --></script>
  {{ super() }}

{% endblock %}
