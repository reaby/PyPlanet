{% extends 'core.views/uikit/v1/generics/bootstrap.xml' %}

{% block main %}
<frame pos="0 45" valign="center" halign="center" z-index="250">
  <label pos="-20.5 -2" size="60 7" text="  Create new folder" textsize="2.5" textcolor="FFFFFFF" halign="left"/>
    <Button text="✖" action="{{id}}__button_close" pos="52 0" size="6 6" id="closeButton" />
    <frame pos="-55 -14" id="folder_body" valign="center" halign="center" z-index="70">
    <label pos="10 -2" size="20 5" text="Name: " textsize="1.2" valign="center2" halign="right"/>
      <Input text="" name="folder_name" pos="10 -2" size="74 4" />

    <frame id="folder_privacy_container">
      <entry hidden="1" id="folder_privacy" name="folder_privacy" default="private"/>
      <Checkbox text="Private, only you can manage it." pos="0 -5" checked="1" disabled="1" id="cb_private" />
      <Checkbox text="Public, readable by everyone, writable by admins. (only for admins)" pos="0 -10" checked="0" disabled="{{is_admin}}" id="cb_public" />
      <Checkbox text="Admins only, visible and writable for admins. (only for admins)" pos="0 -15" checked="0" disabled="{{is_admin_only}}" id="cb_admin_only" />
    </frame>

    </frame>
      <ButtonConfirm text="Save" action="{{id}}__button_save" pos="-20 -43" />
      <ButtonOutline text="Cancel" action="{{id}}__button_cancel" pos="4 -43" />
      <quad pos="0 0" size="120 50" halign="center" valign="top" style="Bgs1InRace" substyle="BgSystemBar" opacity="0.9" scriptevents="1" />
</frame>
{% endblock %}

{% block maniascript %}
  <script><!-- {% include 'jukebox/folder_create.Script.Txt' %} --></script>
{% endblock %}
